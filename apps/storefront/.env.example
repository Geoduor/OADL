# Names only. Public values (NEXT_PUBLIC_*) are visible in the browser.
# API base URL, no trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_API_URL=""
# This site's public address, used for link previews. Local: http://localhost:3001
NEXT_PUBLIC_SITE_URL=""
# Cloudflare Turnstile public site key (not the secret). Empty in local
# development sends a dummy token; the API must then use Cloudflare's test secret.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""
# Manager WhatsApp number, digits only with country code, no plus (Q9).
# Empty hides the "Talk to us" button.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
