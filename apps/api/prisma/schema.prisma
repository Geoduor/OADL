// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  prices     ProductPrice[]
  orderItems OrderItem[]
  stockMovements StockMovement[]

  @@map("products")
}

model ProductPrice {
  id                String  @id @default(uuid())
  productId         String
  quantity          Int
  priceKes          Int
  compareAtPriceKes Int?
  active            Boolean @default(true)

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, quantity])
  @@map("product_prices")
}

// Statuses follow docs/ORDER_LIFECYCLE.md. CONFIRMED is a proposed name (D21).
enum OrderStatus {
  PLACED
  CONFIRMED
  ASSIGNED
  DISPATCHED
  DELIVERED
  UNRESPONSIVE
  RESCHEDULED
  CANCELLED
}

enum OrderSource {
  STOREFRONT
  MANAGER_CREATED
}

// Kenya's 47 counties, seeded from the First Schedule of the Constitution.
model County {
  id   String @id @default(uuid())
  name String @unique
  code Int    @unique

  orders  Order[]
  agents  AgentCounty[]

  @@map("counties")
}

// Order.status is written only by OrderStatusService (docs/ORDER_LIFECYCLE.md).
model Order {
  id             String      @id @default(uuid())
  orderNo        String      @unique
  idempotencyKey String?     @unique
  source         OrderSource @default(STOREFRONT)
  customerName   String
  customerPhone  String
  countyId       String
  location       String
  landingSlug    String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  utmContent     String?
  status         OrderStatus @default(PLACED)
  scheduledDate  DateTime?   @db.Date
  totalKes       Int
  attemptCount   Int         @default(0)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deliveredAt    DateTime?
  assignedAgentId String?

  county        County               @relation(fields: [countyId], references: [id])
  assignedAgent Agent?               @relation(fields: [assignedAgentId], references: [id])
  items         OrderItem[]
  history       OrderStatusHistory[]
  payments      Payment[]
  stockMovements StockMovement[]
  notifications  Notification[]

  @@index([status])
  @@index([countyId])
  @@index([createdAt])
  @@index([assignedAgentId])
  @@map("orders")
}

// Price is copied from ProductPrice at purchase time (docs/DATA_MODEL.md).
model OrderItem {
  id           String @id @default(uuid())
  orderId      String
  productId    String
  quantity     Int
  lineTotalKes Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Append-only. agentId is the agent assigned after the change (null when none).
// changedByUserId is null for the customer's own order placement.
model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  reason          String?
  agentId         String?
  changedByUserId String?
  createdAt       DateTime     @default(now())

  order     Order  @relation(fields: [orderId], references: [id])
  agent     Agent? @relation(fields: [agentId], references: [id])
  changedBy User?  @relation(fields: [changedByUserId], references: [id])

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

enum UserRole {
  MANAGER
  AGENT
}

// A self-registered agent starts PENDING until the manager approves (D26).
// Only ACTIVE users can sign in.
enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

// Staff accounts. Phase 1 signs in with the phone number (D24); email is
// added later. Users are never deleted, they are DISABLED.
model User {
  id           String     @id @default(uuid())
  name         String
  phone        String     @unique
  email        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(PENDING)
  createdAt    DateTime   @default(now())
  agent        Agent?
  statusChanges OrderStatusHistory[]
  paymentsRecorded Payment[]
  stockMovementsCreated StockMovement[]
  notifications Notification[]

  @@map("users")
}

// Server-side sessions for @nestjs/authentication (D28). `id` is the SHA-256
// of the cookie token; the token itself is never stored. userId has no
// foreign key on purpose: the package's store contract tests save sessions
// for ids that are not in `users`, and users are never hard-deleted.
model Session {
  id           String   @id
  userId       String
  createdAt    DateTime
  expiresAt    DateTime
  lastActiveAt DateTime
  mfa          String?
  metadata     Json?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}


// A field agent's working profile. Created when the manager approves the
// agent's registration (D26). `active` controls whether the agent receives
// assignments; it is separate from User.status (can the account sign in).
model Agent {
  id          String        @id @default(uuid())
  userId      String        @unique
  user        User          @relation(fields: [userId], references: [id])
  displayName String
  active      Boolean       @default(true)
  counties    AgentCounty[]
  orders      Order[]
  history     OrderStatusHistory[]
  payments    Payment[]
  stockMovements StockMovement[]
  createdAt   DateTime      @default(now())

  @@map("agents")
}

// Which counties an agent covers. The manager sets them at approval.
// Several agents may cover one county (Q4 is still open on the real mapping).
model AgentCounty {
  agentId  String
  agent    Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  countyId String
  county   County @relation(fields: [countyId], references: [id])

  @@id([agentId, countyId])
  @@map("agent_counties")
}

// How the customer paid the agent on delivery (D34). The customer pays the
// agent in cash or M-Pesa; what the agent later sends to the manager is a
// separate settlement step that is not built yet.
enum PaymentMethod {
  CASH
  MPESA
}

// Append-only: no update or delete. One row is written when the agent marks
// the order Delivered, in the same transaction as the status change.
model Payment {
  id               String        @id @default(uuid())
  orderId          String
  agentId          String
  method           PaymentMethod
  amountKes        Int
  recordedByUserId String
  createdAt        DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id])
  agent      Agent @relation(fields: [agentId], references: [id])
  recordedBy User  @relation(fields: [recordedByUserId], references: [id])

  @@index([orderId])
  @@index([agentId, method])
  @@map("payments")
}

enum StockMovementType {
  ISSUE
  DELIVERY
  RETURN_TO_STORE
  ADJUSTMENT
}

// Append-only stock ledger per agent and product, in units (D7, D35). On hand
// is the sum of an agent's movements; it is never stored as a single number.
// Signs: ISSUE +, DELIVERY -, RETURN_TO_STORE -, ADJUSTMENT +/-.
model StockMovement {
  id              String            @id @default(uuid())
  agentId         String
  productId       String
  type            StockMovementType
  quantity        Int
  orderId         String?
  note            String?
  createdByUserId String
  createdAt       DateTime          @default(now())

  agent     Agent   @relation(fields: [agentId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  order     Order?  @relation(fields: [orderId], references: [id])
  createdBy User    @relation(fields: [createdByUserId], references: [id])

  // An order can deduct a product at most once, even if two requests race.
  // (Rows without an order are not constrained: Postgres treats NULLs as
  // distinct.)
  @@unique([orderId, productId, type])
  @@index([agentId, productId])
  @@map("stock_movements")
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ASSIGNED
  ORDER_RELEASED
  ORDER_STATUS_CHANGED
}

// A stored in-app notification (docs/DATA_MODEL.md). Titles and bodies carry
// the order number and county only, never the customer's name, phone or
// address, because push services will carry them later. Deleting a user or an
// order removes their notifications: they are derived data, and production
// never hard-deletes either.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  orderId   String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}
