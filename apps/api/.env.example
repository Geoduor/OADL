DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"
# Cloudflare Turnstile secret key (server only). See README for the local test value.
CAPTCHA_SECRET=""
# Express "trust proxy" value behind a proxy: a hop count, address list or keyword. UNVERIFIED for Render, see docs/DEPLOYMENT.md.
TRUST_PROXY=""
# Browser origins allowed to call the API, comma separated (scheme://host[:port]): the portal (cookies) and the storefront (public order form). Local example: http://localhost:3001
# Example: https://app.example.com,https://shop.example.com
CORS_ORIGINS=""
# Web Push (optional; push is off when any of the three is empty). Generate the pair once: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# https: or mailto: contact for the push services, for example mailto:you@example.com. Not localhost.
VAPID_SUBJECT=""
